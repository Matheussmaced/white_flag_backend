    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "5.2.3",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.19.3",
    "@vercel/functions": "^3.10.1",
    "dotenv": "^18.0.8",
